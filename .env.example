# --- Firebase client (public by design: NEXT_PUBLIC_* ends up in the browser bundle) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only, never NEXT_PUBLIC_) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escapes, the app converts them to real line breaks
FIREBASE_PRIVATE_KEY=

# --- Daily vacation accrual (Vercel Cron, see vercel.json) ---
# Any long random string. Vercel sends it as `Authorization: Bearer <CRON_SECRET>`; without it the job refuses to run.
CRON_SECRET=

# --- Access control ---
# Access is a whitelist: only emails registered on an active employee can sign in (any domain).
# Comma-separated emails that become admins on their first sign-in (bootstrap only)
INITIAL_ADMIN_EMAILS=

# --- Spreadsheet import (optional) ---
# gid of the tabs read by the import, if the team's sheet changes (defaults are the current tabs)
IMPORT_VACATIONS_GID=
IMPORT_OVERTIME_GID=
